# 複製成 app/AiButler/.env 供本機開發使用（.env 已被 repo 根目錄 .gitignore 擋住）。
#
# 部署到 AgentCore Runtime 後，MEMORY_BUTLERMEMORY_ID 由 CDK 自動注入，
# AWS 憑證由 execution role 提供 —— 這裡不需要放任何金鑰。

AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# 本機測記憶功能時，填 agentcore deploy 之後產生的 memory id。
# 留空 = 關閉跨 session 記憶，只跑單輪對話。
MEMORY_ID=

# 隊友的 bff_server。留空 = 用 backend.py 的內建假資料，
# 不必等後端就緒就能開發。例：http://52.10.163.115:8100
BFF_BASE_URL=

LOG_LEVEL=INFO
