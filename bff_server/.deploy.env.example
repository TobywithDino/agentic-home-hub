# 複製成 .deploy.env 再填。這個檔案不進版控（含 AWS 基礎設施識別資訊）。
#
#   cp .deploy.env.example .deploy.env
#
# 值從哪裡來：
#   AWS_PROFILE      你本機的 AWS CLI profile 名稱
#   INSTANCE_ID      EC2 執行個體 id
#   S3_BUCKET        部署用的 S3 bucket
#   EC2_IP           EC2 公有 IP
#   AGENTCORE_RUNTIME_ARN
#       在 agent_service/ 底下跑 `agentcore status --json`，
#       取 resources 裡 resourceType=agent 的 identifier。
#       留空 = 不啟用 AI 管家（端點會回一筆 error 事件，不會讓服務崩掉）。

AWS_PROFILE=agentic-home-hub
AWS_REGION=us-west-2
INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
S3_BUCKET=aiwave-deploy-xxxxxxxxxxxx-uswest2
EC2_IP=xx.xx.xx.xx

AGENTCORE_RUNTIME_ARN=
AGENTCORE_QUALIFIER=DEFAULT
