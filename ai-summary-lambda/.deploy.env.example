# 複製成 .deploy.env 再填。這個檔案不進版控（含 AWS 基礎設施識別資訊）。
#
#   cp .deploy.env.example .deploy.env
#
# 值從哪裡來：
#   AWS_PROFILE      你本機的 AWS CLI profile 名稱（和 bff_server 共用同一組憑證）
#   S3_BUCKET        部署用的 S3 bucket（和 bff_server 共用）
#   BFF_BASE_URL     EC2 上 bff_server 的位址（http://<EC2_IP>:8100）

AWS_PROFILE=agentic-home-hub
AWS_REGION=us-west-2

# Lambda 設定
FUNCTION_NAME=aiwave-review-summary
TIMEOUT=300
MEMORY=256

# S3（和 bff_server 共用）
S3_BUCKET=aiwave-deploy-xxxxxxxxxxxx-uswest2

# Lambda 環境變數
BFF_BASE_URL=http://xx.xx.xx.xx:8100
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_REGION=us-west-2
MAX_TOKENS=2048
