# PostgreSQL 連線設定
PG_HOST=localhost
PG_PORT=5432
PG_DBNAME=aiwave
PG_USER=postgres
PG_PASSWORD=
# 本地測試用 disable/prefer；連線 AWS RDS 建議用 require
PG_SSLMODE=prefer

# PII 欄位 AES-256-GCM 加密金鑰（base64 編碼，解碼後需為 32 bytes）。
# 未設定時，PII 加解密功能停用：寫入時 bytea 欄位存 NULL（僅 _hash 欄位可用），
# 讀取時一律回傳 null，不會產生無法復原的假密文。
PII_ENCRYPTION_KEY_B64=

# CORS 允許來源，預設 * 僅供本地開發使用，正式環境請改為實際網域白名單
CORS_ALLOW_ORIGINS=*
